{:profiles {:Default {:default true}}

 ;; Shared helpers and app conditions
 :templates {:open "open -a '%s'"}
 :applications {:safari ["^com\\.apple\\.Safari"]}

 :main [;; Section: App-specific remaps
        {:des "Safari only: Esc -> Option+Esc"
         :rules [[:escape :!Oescape :safari]]}

        ;; Section: Modifier behavior
        {:des "Caps Lock: tap = Escape, hold = Meh (Ctrl+Opt+Shift)"
         :rules [[:##caps_lock :!TOleft_shift nil {:alone :escape}]]}

        ;; Section: App launcher shortcuts
        {:des "Caps (Meh) App Switcher"
         :rules [[:!TOS1 [:open "Helium"]]
                 [:!TOS2 [:open "Termy"]]
                 [:!TOS3 [:open "Zed"]]
                 [:!TOS4 [:open "Codex"]]]}

        ;; Section: Navigation shortcuts
        {:des "Caps (Meh) Navigation (IJKL Arrow Pad, U/O Page Up/Down)"
         :rules [[:!TOSi :up_arrow]
                 [:!TOSj :left_arrow]
                 [:!TOSk :down_arrow]
                 [:!TOSl :right_arrow]
                 [:!TOSu :page_up]
                 [:!TOSo :page_down]]}

        ;; Section: Rectangle window management (Caps+Cmd)
        {:des "Rectangle: Caps+Cmd+J/L/K = Left/Right/Maximize"
         :rules [[:!!j :!TOleft_arrow]
                 [:!!l :!TOright_arrow]
                 [:!!k :!TOreturn_or_enter]]}]}
