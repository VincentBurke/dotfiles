# ~/.zshrc
# Readable, macOS-friendly, with safer PATH handling, better history, faster completions,
# hardened aliases, and fnm-managed Node + zoxide + fzf.

# Prompt preset. Valid values:
# - p10k: current fast Powerlevel10k prompt with instant prompt
# - starship: fallback no-OMZ Starship prompt using ~/.config/starship.toml
ZSH_PROMPT_PRESET="${ZSH_PROMPT_PRESET:-p10k}"

# Enable Powerlevel10k instant prompt. This must stay near the top of the file.
if [[ "$ZSH_PROMPT_PRESET" == "p10k" ]] && [[ -r "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh" ]]; then
  source "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh"
fi

# ------------------ MACOS / HOMEBREW ------------------
# Ensure Homebrew (Apple Silicon / Intel) is available early so brew-installed tools resolve.
if [[ -x /opt/homebrew/bin/brew ]]; then
  eval "$(/opt/homebrew/bin/brew shellenv)"
elif [[ -x /usr/local/bin/brew ]]; then
  eval "$(/usr/local/bin/brew shellenv)"
fi


# ------------------ BASIC OPTIONS & HISTORY ------------------
# Good defaults for developer workflows: shared history, fewer dupes, less noise.
HISTFILE="$HOME/.zsh_history"
HISTSIZE=50000
SAVEHIST=50000

setopt APPEND_HISTORY        # append rather than overwrite
setopt INC_APPEND_HISTORY    # write history as commands are entered
setopt SHARE_HISTORY         # share history across sessions
setopt HIST_IGNORE_ALL_DUPS  # drop older duplicate commands
setopt HIST_FIND_NO_DUPS     # don't show dupes during search
setopt HIST_REDUCE_BLANKS    # trim extra blanks
setopt EXTENDED_HISTORY      # timestamps + duration

setopt AUTO_CD               # typing a directory name cd's into it
setopt INTERACTIVE_COMMENTS  # allow comments in interactive shell
setopt NO_BEEP


# ------------------ PATHS / EXPORTS ------------------
# Use zsh's arrays + de-dupe. Only add dirs that exist.
typeset -U path PATH fpath
path_prepend() { [[ -d "$1" ]] && path=("$1" $path); }
first_readable() {
  local candidate
  for candidate in "$@"; do
    [[ -r "$candidate" ]] && {
      print -r -- "$candidate"
      return 0
    }
  done
  return 1
}

# Bun (script install)
export BUN_INSTALL="$HOME/.bun"
path_prepend "$BUN_INSTALL/bin"

# Deno
export DENO_INSTALL="$HOME/.deno"
path_prepend "$DENO_INSTALL/bin"

# Other custom tooling
path_prepend "$HOME/.antigravity/antigravity/bin"


# ------------------ FNM (Fast Node Manager) ------------------
# Shell integration:
# - adds fnm-managed Node binaries to PATH
# - auto-switches versions on cd when it sees .nvmrc or .node-version
if (( $+commands[fnm] )); then
  eval "$(fnm env --use-on-cd --shell zsh)"
fi

# ------------------ ZOXIDE ------------------
# smarter cd; provides `z` (and optionally `zi`)
if (( $+commands[zoxide] )); then
  eval "$(zoxide init zsh)"
fi

# Quick interactive jump (zi exists when zoxide+fzf are available; alias is harmless either way)
alias zz='zi'

# Show top-ranked dirs (good for discovering what zoxide has learned)
alias ztop='zoxide query -ls | head -n 30'

# ------------------ SHELL UX ------------------
# The old oh-my-zsh framework load is intentionally gone. These plugins come from Homebrew formulas.
ZSH_AUTOSUGGESTIONS="$(first_readable \
  /opt/homebrew/share/zsh-autosuggestions/zsh-autosuggestions.zsh \
  /usr/local/share/zsh-autosuggestions/zsh-autosuggestions.zsh)"
if [[ -n "$ZSH_AUTOSUGGESTIONS" ]]; then
  source "$ZSH_AUTOSUGGESTIONS"
else
  print -u2 "zsh-autosuggestions not found. Install the Homebrew formula."
fi


# ------------------ COMPLETIONS ------------------
# Use native compinit with Homebrew site-functions and a cached dump file.
for d in /opt/homebrew/share/zsh/site-functions /usr/local/share/zsh/site-functions; do
  [[ -d "$d" ]] && fpath=("$d" $fpath)
done

# Faster, more forgiving completions (menu selection + caching + basic case-insensitive matching).
zstyle ':completion:*' menu select
zstyle ':completion:*' use-cache on
zstyle ':completion:*' cache-path "$HOME/.zsh/cache"
zstyle ':completion:*' matcher-list \
  'm:{a-zA-Z}={A-Za-z}' \
  'r:|[._-]=* r:|=*'

autoload -Uz compinit
compinit -C -d "$HOME/.zcompdump-$HOST-$ZSH_VERSION"

# ------------------ FZF ------------------
# Key bindings + fuzzy completion for zsh
if (( $+commands[fzf] )); then
  source <(fzf --zsh)
fi


# ------------------ ALIASES ------------------
# eza (modern ls) aliases, only if installed
if (( $+commands[eza] )); then
  alias ls='eza --icons --grid --group-directories-first'
  alias ll='eza -l'
  alias la='eza -la'
  alias lt='eza -T'
fi

# VS Code / VSCodium, only if installed
if (( $+commands[codium] )); then
  alias code="codium"
fi

# General
alias zshconfig='$EDITOR ~/.zshrc'
alias zshsource='source ~/.zshrc'
alias ohmyzsh='cd ~/.oh-my-zsh'
alias sshhome='cd ~/.ssh'
alias sshconfig='$EDITOR ~/.ssh/config'

# IP helper: uses the default route interface (more robust than hardcoding en0)
ip() {
  local iface
  iface="$(route -n get default 2>/dev/null | awk '/interface:/{print $2; exit}')"
  [[ -n "$iface" ]] && ipconfig getifaddr "$iface"
}

# Prefer bunx over npx so this doesn't trigger node toolchain init
alias loc="bunx sloc --format cli-table --format-option head --exclude 'build|\\.svg$|\\.xml$' ./"
alias ccusage='bunx @ccusage/codex@latest'

# Git
alias gits='git status'
alias gitd='git diff'
alias gitl='git lg'
alias gita='git add .'
alias gco='git checkout'
alias gsw='git switch'
alias gc='git commit'
alias gitc='cz commit'
alias remove-gone-branches="git branch -vv | sed 's/^\\*//' | grep ': gone]' | awk '{print $1}' | (xargs git branch --delete 2>/dev/null || echo 'No branches to delete')"


# Random
alias crr='cargo run --release'

# Codex
alias checkcodex='RUST_LOG="codex_api::sse::responses=trace" codex exec --skip-git-repo-check -s read-only -m gpt-5.3-codex -c "model_reasoning_effort=medium" "Say exactly this sentence and nothing else: \"Hello, this is the answer.\"" >/tmp/codex_stdout.txt 2>/tmp/codex_sse_trace.log; python3 -c "import json,re; expected=\"gpt-5.3-codex\"; log=\"/tmp/codex_sse_trace.log\"; model=None
for line in open(log,\"r\",errors=\"ignore\"):
 m=re.search(r\"(\{.*\})\", line)
 if not m: continue
 try: obj=json.loads(m.group(1))
 except Exception: continue
 resp=obj.get(\"response\") or {}
 model=resp.get(\"model\") or obj.get(\"model\") or model
 if model: break
status=\"MODEL OK\" if model==expected else \"MODEL MISMATCH\"
print(f\"{status}: {model}\")"'


# ------------------ FUNCTIONS / COMPLETIONS ------------------
# UV autocompletion helper for `uv run`
_uv_run_mod() {
  if [[ "$words[2]" == "run" && "$words[CURRENT]" != -* ]]; then
    if [[ ${words[3,$((CURRENT-1))]} =~ ".*\\.py" ]]; then
      _arguments '*:filename:_files'
    else
      _arguments '*:filename:_files -g "*.py"'
    fi
  else
    # Fall back to uv's completion function if it exists
    if (( $+functions[_uv] )); then
      _uv "$@"
    else
      return 1
    fi
  fi
}
# Only register if uv's completion is actually available
if (( $+functions[_uv] )); then
  compdef _uv_run_mod uv
fi


# ------------------ PROMPT ------------------
# Both prompt presets share the faster no-OMZ shell init above.
POWERLEVEL10K_THEME="$(first_readable \
  /opt/homebrew/share/powerlevel10k/powerlevel10k.zsh-theme \
  /usr/local/share/powerlevel10k/powerlevel10k.zsh-theme)"

case "$ZSH_PROMPT_PRESET" in
  p10k)
    if [[ -n "$POWERLEVEL10K_THEME" ]]; then
      source "$POWERLEVEL10K_THEME"
      [[ -r "${ZDOTDIR:-$HOME}/.p10k.zsh" ]] && source "${ZDOTDIR:-$HOME}/.p10k.zsh"
    else
      print -u2 "powerlevel10k theme not found. Install the brew formula or set ZSH_PROMPT_PRESET=starship."
    fi
    ;;
  starship)
    if (( $+commands[starship] )); then
      eval "$(starship init zsh)"
    else
      print -u2 "starship command not found. Install the brew formula or set ZSH_PROMPT_PRESET=p10k."
    fi
    ;;
  *)
    print -u2 "Unknown ZSH_PROMPT_PRESET=$ZSH_PROMPT_PRESET (expected p10k or starship)."
    ;;
esac


# Update dotfiles
update-dotfiles() {
  set -euo pipefail

  local msg="${*:-Update dotfiles}"
  local brewfile="$HOME/.config/homebrew/Brewfile"

  # 1) You edited files in $HOME; copy changes back into chezmoi source state
  chezmoi re-add

  # 2) Update Brewfile (explicit installs, not deps)
  if command -v brew >/dev/null 2>&1; then
    mkdir -p "$(dirname "$brewfile")"

    brew bundle dump \
      --file="$brewfile" \
      --force \
      --describe \
      --formula --cask --tap

    # Ensure chezmoi tracks it (safe if already added)
    chezmoi add "$brewfile" >/dev/null 2>&1 || true
  fi

  # 3) Commit + push if anything changed in the chezmoi repo
  if [[ -z "$(chezmoi git -- status --porcelain)" ]]; then
    echo "No dotfile changes to push."
    return 0
  fi

  chezmoi git -- add -A
  chezmoi git -- commit -m "$msg"
  chezmoi git -- push
}

# TEMY SHELL INTEGRATION
if [[ "${TERMY_SHELL_INTEGRATION:-0}" == "1" ]]; then
  _termy_emit_tab_title() {
    local kind="$1"
    shift
    local payload="$*"
    local prefix="${TERMY_TAB_TITLE_PREFIX:-termy:tab:}"
    payload=${payload//$'\n'/ }
    payload=${payload//$'\r'/ }
    printf '\033]2;%s%s:%s\007' "$prefix" "$kind" "$payload"
  }

  _termy_prompt_title() {
    _termy_emit_tab_title "prompt" "${PWD/#$HOME/~}"
  }

  _termy_command_title() {
    _termy_emit_tab_title "command" "$1"
  }

  autoload -Uz add-zsh-hook
  add-zsh-hook precmd _termy_prompt_title
  add-zsh-hook preexec _termy_command_title
fi


# Prefer $EDITOR over hardcoding vim
export EDITOR="zed"
alias -s md='$EDITOR'



# ------------------ MUST BE LAST ------------------
# zsh-syntax-highlighting should be sourced at the very end.
ZSH_SYNTAX_HIGHLIGHTING="$(first_readable \
  /opt/homebrew/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh \
  /usr/local/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh)"
if [[ -n "$ZSH_SYNTAX_HIGHLIGHTING" ]]; then
  source "$ZSH_SYNTAX_HIGHLIGHTING"
else
  print -u2 "zsh-syntax-highlighting not found. Install the Homebrew formula."
fi

# pnpm
export PNPM_HOME="$HOME/Library/pnpm"
case ":$PATH:" in
  *":$PNPM_HOME:"*) ;;
  *) export PATH="$PNPM_HOME:$PATH" ;;
esac
